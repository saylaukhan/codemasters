{
  "uid": "vko-server-health",
  "title": "Сервер мониторинга ВКО",
  "description": "Состояние самого сервера: запросы к API, ошибки, задержки, задачи Celery (T-54). Качество интернета в школах — в веб-панели, не здесь.",
  "tags": ["vko", "backend"],
  "timezone": "Asia/Almaty",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "vko-prometheus" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы к API, в секунду",
      "description": "Скорость запросов по коду ответа. Источник — vko_http_requests_total.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(vko_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Задержка API: 95-й процентиль",
      "description": "Медленнее этого времени отвечает каждый двадцатый запрос. Источник — vko_http_request_duration_seconds.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(vko_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Доля ошибочных ответов за час",
      "description": "Ответы 5xx к общему числу запросов. Растёт — смотреть Sentry.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vko_http_requests_total{status=~\"5..\"}[1h])) / clamp_min(sum(rate(vko_http_requests_total[1h])), 0.001)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Приём замеров, в секунду",
      "description": "Запросы агентов на POST /api/measurements: упало до нуля — агенты не доходят до сервера.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vko_http_requests_total{path=~\"/api/measurements.*\"}[15m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Задачи Celery, в минуту",
      "description": "Исход задач фонового воркера. Источник — vko_celery_tasks_total.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*failure.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, state) (rate(vko_celery_tasks_total[5m]) * 60)",
          "legendFormat": "{{task}} — {{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Длительность задач Celery: 95-й процентиль",
      "description": "Детекция инцидентов идёт каждые 5 минут, пересчёт договоров — каждые 15: задача не должна занимать дольше своего интервала.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(vko_celery_task_duration_seconds_bucket[15m])))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Доступность источников метрик",
      "description": "1 — Prometheus видит процесс, 0 — не видит. Ноль у api или worker означает, что процесс не отвечает.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|worker\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
