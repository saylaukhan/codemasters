# Локальные значения для разработки — секретов здесь нет.
# Скопируйте: cp .env.example .env  (.env в репозиторий не попадает, см. .gitignore).
# Файл читают docker compose и backend (pydantic-settings); Makefile берёт отсюда только
# POSTGRES_* для make db-reset — в них без кавычек, пробелов и символов $ и #.
# Комментарии — только отдельной строкой.

# PostgreSQL 16 + TimescaleDB + PostGIS — контейнер db, порт 5432
POSTGRES_DB=vko_monitor
POSTGRES_USER=vko
POSTGRES_PASSWORD=vko

# Подключение с машины разработчика (make api, make migrate, make seed).
# Внутри compose для api / worker / beat хост подменяется на db (см. docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://vko:vko@localhost:5432/vko_monitor

# Redis — брокер и backend Celery, а также счётчик лимита запросов агентов; контейнер redis,
# порт 6379
REDIS_URL=redis://localhost:6379/0

# Лимит API агентов (T-51): сколько запросов за окно может сделать одно устройство и один
# адрес без токена (регистрация). 0 — лимит выключен; недоступный Redis замер не теряет.
AGENT_RATE_LIMIT=120
AGENT_REGISTER_RATE_LIMIT=20
AGENT_RATE_LIMIT_WINDOW_S=60

# Секрет подписи JWT панели. Только для локальной разработки; в бою — длинная случайная строка.
SECRET_KEY=local-dev-only-change-me

# Публичный адрес API (ссылки в уведомлениях, письмах, отчётах)
API_BASE_URL=http://localhost:8000

# Часовой пояс интерфейса и отчётов (ADR-014). Хранение — всегда UTC.
TZ=Asia/Almaty

# Начальные адреса серверов замеров: LibreSpeed — контейнер speedtest, порт 8080; резервный
# ndt7 — контейнер ndt7, порт 8081 (пусто — без резерва). В settings их кладёт make seed, только
# если записи ещё нет; рабочие значения меняются в админке и приходят агенту с сервера — в агент
# и панель адреса не зашиваются (ADR-012).
SPEEDTEST_URL=http://localhost:8080
NDT7_URL=ws://localhost:8081

# AI-черновики обращений (T-46, ADR-011). LLM_PROVIDER: claude — Messages API по сети,
# deepseek — Chat Completions API по сети (T-83), ollama — модель закрытого контура рядом
# с сервером. Ключ — только здесь, в окружении; пусто — черновик недоступен, сервис
# работает, текст пишется вручную.
# LLM_MODEL и LLM_URL пустые — берутся значения по умолчанию провайдера.
LLM_PROVIDER=claude
LLM_API_KEY=
LLM_MODEL=
LLM_URL=

# Помощник по интерфейсу (T-84, ADR-017): боковая панель с вопросами о панели у всех ролей.
# Отвечает та же модель, что пишет черновики (LLM_*); без ключа модели кнопки в шапке нет.
# false — выключить помощник совсем; сервис работает как прежде.
ASSISTANT_ENABLED=true

# Токен Telegram-бота для уведомлений (T-42). Пусто — канал отключён.
TELEGRAM_BOT_TOKEN=

# SMTP для уведомлений и писем обращений (T-42, T-48). Пусто — письмо помечается «не отправлено».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Наблюдаемость сервера (T-54). Пустой DSN — Sentry выключен, приложение работает как
# обычно и никуда ничего не отправляет. Персональные данные в отчёты не попадают.
# sentry_traces_sample_rate: доля запросов с трассировкой, 0 — только ошибки.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
# Порт, на котором воркер Celery отдаёт метрики Prometheus внутри сети compose.
WORKER_METRICS_PORT=9808
# Вход в Grafana (http://127.0.0.1:3000, только с самого сервера). Смените пароль на боевом.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Резервное копирование БД (T-53); включается вторым файлом compose:
# docker compose -f docker-compose.yml -f docker-compose.backup.yml up -d
# Секретов здесь нет: pgbackrest ходит к базе по unix-сокету, пароль не нужен.
# PGBACKREST_REPO1_PATH — путь хранилища внутри контейнера, на него смонтирован том
# pgbackrest_repo; стендж и имя каталога должны совпадать с deploy/pgbackrest/pgbackrest.conf.
PGBACKREST_STANZA=vko
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
# Время ежедневного полного бэкапа, ЧЧ:ММ по часовому поясу TZ.
PGBACKREST_BACKUP_AT=02:30
# Сколько полных бэкапов хранить; вместе с ними удаляется и их архив WAL.
PGBACKREST_RETENTION_FULL=7

# Домен для Caddy. localhost — локальный самоподписанный сертификат;
# реальный домен с DNS на этот хост — сертификат Let's Encrypt автоматически.
CADDY_DOMAIN=localhost
